# 复制为 .env 后按需修改。所有项都可省略。

# 监听地址与端口
HOST=0.0.0.0
PORT=3000

# HTTPS 部署（云服务器 + Caddy）时设为 true；局域网 HTTP 部署时保持 false
COOKIE_SECURE=false
# 在反向代理后面时设为 true，以便取到真实 IP
TRUST_PROXY=false

# 数据库文件位置，默认 data/app.db。里面有明文的网易云 Cookie，放在网站目录之外
# DB_PATH=/var/lib/party-music-player/app.db

# JWT 密钥，不填则首次启动随机生成并存进数据库
# JWT_SECRET=

# 额外允许的 Origin（逗号分隔），默认只允许与 Host 同源
# ALLOWED_ORIGINS=

# 设为 fake 使用假的音乐源（不访问网易云，开发和测试用）
# MUSIC_PROVIDER=fake

# SMTP（配置后管理员才能打开邮箱验证）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=聚会音乐播放器 <noreply@example.com>

# Cloudflare Turnstile（配置后管理员才能打开）
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

LOG_LEVEL=info
